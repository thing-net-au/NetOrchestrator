@rendermode InteractiveServer
@page "/services"
@using System.Net.Http
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Orchestrator.Core
@using Orchestrator.Core.Models

@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Services - Orchestrator</PageTitle>

<h1>Service Management</h1>

<div class="mb-3">
    <span>Status stream: </span>
    @if (!statusConnected)
    {
<span class="text-danger">?? Disconnected</span>
        <button class="btn btn-sm btn-link" @onclick="ConnectStatus">Reconnect</button>
    }
    else
    {
        <span class="text-success">?? Live</span>
        <button class="btn btn-sm btn-link text-muted" @onclick="DisconnectStatus">Disconnect</button>
    }
</div>

@if (services != null)
{
    <div class="row mb-4">
        <div class="col-md-3">
   <div class="card">
         <div class="card-body">
           <h5 class="card-title">Total Services</h5>
               <p class="card-text display-4">@TotalServiceCount</p>
    </div>
         </div>
        </div>
        <div class="col-md-3">
  <div class="card border-success">
       <div class="card-body">
         <h5 class="card-title">Running Services</h5>
          <p class="card-text display-4 text-success">@RunningServiceCount</p>
        </div>
         </div>
        </div>
        <div class="col-md-3">
   <div class="card border-warning">
      <div class="card-body">
 <h5 class="card-title">Stopped Services</h5>
       <p class="card-text display-4 text-warning">@(TotalServiceCount - RunningServiceCount)</p>
  </div>
     </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
           <div class="card-body">
        <h5 class="card-title">Total Instances</h5>
       <p class="card-text display-4 text-info">@TotalRunningInstances</p>
     </div>
 </div>
        </div>
    </div>
}

@if (services is null)
{
    <div class="text-center my-5">
        <div class="spinner-border" role="status">
       <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading services...</p>
    </div>
}
else
{
    <div class="table-responsive">
  <table class="table table-striped table-hover">
     <thead class="table-dark">
   <tr>
     <th>Service Name</th>
  <th>Running Instances</th>
         <th>State</th>
           <th>Last Report</th>
  <th>Actions</th>
           </tr>
            </thead>
          <tbody>
      @foreach (var svc in services)
    {
    <tr class="@GetRowClass(svc.State)">
            <td><strong>@svc.Name</strong></td>
           <td>
 <span class="badge bg-@GetBadgeColor(svc.RunningInstances)">
      @svc.RunningInstances
        </span>
           </td>
                  <td>
         <span class="badge bg-@GetStateBadgeColor(svc.State)">
    @svc.State
        </span>
       </td>
        <td>
                   @if (svc.LastReportAt.HasValue)
     {
  <small>@svc.LastReportAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</small>
}
      else
    {
  <small class="text-muted">Never</small>
             }
        </td>
   <td>
      <div class="btn-group btn-group-sm" role="group">
         <button class="btn btn-success" @onclick="() => Start(svc.Name)" title="Start Instance">
         <i class="bi bi-play-fill"></i> Start
         </button>
      <button class="btn btn-danger" @onclick="() => Stop(svc.Name)" title="Stop Instance">
           <i class="bi bi-stop-fill"></i> Stop
      </button>
      <button class="btn btn-info" @onclick="() => ShowLogs(svc.Name)" title="View Logs">
       <i class="bi bi-file-text"></i> Logs
          </button>
     </div>
         </td>
   </tr>
     }
            </tbody>
        </table>
    </div>

    @if (selectedService != null)
    {
        <div class="card mt-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
      <span><strong>Logs: @selectedService</strong></span>
     <div>
 @if (!logConnected)
              {
       <span class="badge bg-danger me-2">Disconnected</span>
   }
                else
{
             <span class="badge bg-success me-2">Live</span>
              }
         <button class="btn btn-sm btn-outline-light" @onclick="DisconnectLog">
      <i class="bi bi-x"></i> Close
  </button>
          </div>
         </div>
       <div class="card-body p-0">
                <pre class="bg-dark text-light p-3 mb-0" style="height:400px; overflow:auto; font-size:0.85rem;">@foreach (var entry in logEntries)
{<div><span class="text-muted">[@entry.Timestamp.ToString("HH:mm:ss")]</span> @entry.Message</div>}</pre>
</div>
   </div>
    }
}

@implements IAsyncDisposable

@code {
    private List<ServiceStatus>? services;
    private bool statusConnected;
  private bool logConnected;
    private string? selectedService;
    private List<(DateTime Timestamp, string Message)> logEntries = new();

    private int TotalServiceCount => services?.Count ?? 0;
  private int RunningServiceCount => services?.Count(s => s.State == State.Running) ?? 0;
    private int TotalRunningInstances => services?.Sum(s => s.RunningInstances) ?? 0;

    private DotNetObjectReference<Services>? statusRef;
    private DotNetObjectReference<Services>? logRef;

    private bool _interactive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            await ConnectStatus();
      }
    }

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    private string GetRowClass(State state) => state switch
    {
        State.Running => "table-success-subtle",
   State.Stopped => "table-warning-subtle",
      State.Failed => "table-danger-subtle",
        _ => ""
    };

private string GetBadgeColor(int count) => count switch
    {
  0 => "secondary",
        1 => "primary",
        _ => "success"
    };

    private string GetStateBadgeColor(State state) => state switch
    {
        State.Running => "success",
        State.Stopped => "warning",
     State.Failed => "danger",
        State.Suspended => "info",
        _ => "secondary"
    };

    private async Task ConnectStatus()
    {
 var baseUri = new Uri(Nav.BaseUri);
      var apiPort = OrchestratorConfig.Current.Web.ApiPort;
        var apiOrigin = new UriBuilder(baseUri.Scheme, baseUri.Host, apiPort).Uri;

        statusRef?.Dispose();
        statusRef = DotNetObjectReference.Create(this);

        var statusUrl = new Uri(apiOrigin, "/api/services/stream").ToString();

      await JS.InvokeVoidAsync("logStream.status.open", statusRef, statusUrl);
   statusConnected = true;
        StateHasChanged();
    }

    private async Task DisconnectStatus()
    {
        await JS.InvokeVoidAsync("logStream.status.close");
      statusConnected = false;
        StateHasChanged();
    }

    private async Task Refresh()
    {
        try
 {
            var client = ClientFactory.CreateClient("OrcApi");
       services = await client.GetFromJsonAsync<List<ServiceStatus>>("api/services");
            StateHasChanged();
        }
   catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to refresh services: {ex.Message}");
        }
    }

    private async Task Start(string name)
    {
        try
        {
            var client = ClientFactory.CreateClient("OrcApi");
      await client.PostAsync($"api/services/{name}/start", null);
    await Task.Delay(500); // Brief delay to allow service to start
            await Refresh();
    }
    catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to start service {name}: {ex.Message}");
        }
    }

    private async Task Stop(string name)
    {
     try
        {
 var client = ClientFactory.CreateClient("OrcApi");
   await client.PostAsync($"api/services/{name}/stop", null);
            await Task.Delay(500); // Brief delay to allow service to stop
       await Refresh();
 }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to stop service {name}: {ex.Message}");
  }
    }

    private async Task ShowLogs(string name)
    {
        selectedService = name;
    var baseUri = new Uri(Nav.BaseUri);
        var apiPort = OrchestratorConfig.Current.Web.ApiPort;
        var apiOrigin = new UriBuilder(baseUri.Scheme, baseUri.Host, apiPort).Uri;

    var logsUrl = new Uri(apiOrigin, $"/api/services/{name}/logs/stream").ToString();
        logEntries.Clear();
        logConnected = false;

        logRef?.Dispose();
        logRef = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync("logStream.serviceLog.open", logRef, logsUrl);
        logConnected = true;
   StateHasChanged();
    }

    private async Task DisconnectLog()
    {
   await JS.InvokeVoidAsync("logStream.serviceLog.close");
        logConnected = false;
     selectedService = null;
     StateHasChanged();
    }

    [JSInvokable]
public void StatusOpened()
    {
        statusConnected = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void ReceiveStatus(string json)
  {
        try
    {
   var updated = JsonSerializer.Deserialize<ServiceStatus>(json);
      if (updated != null && services != null)
     {
       var svc = services.FirstOrDefault(s => s.Name == updated.Name);
              if (svc != null)
            {
           svc.RunningInstances = updated.RunningInstances;
     svc.State = updated.State;
      svc.LastReportAt = updated.LastReportAt;
  StateHasChanged();
      }
          }
}
        catch (JsonException ex)
        {
    Console.Error.WriteLine($"Failed to parse status update: {ex.Message}");
  }
    }

    [JSInvokable]
    public void ReceiveLogChunk(string chunk)
    {
        try
        {
     const int MaxLogEntries = 500;
            var message = JsonSerializer.Deserialize<ConsoleLogMessage>(chunk);
            if (message != null)
            {
         if (logEntries.Count >= MaxLogEntries)
          logEntries.RemoveAt(0);
      logEntries.Add((message.Timestamp, message.Details ?? ""));
              logConnected = true;
                StateHasChanged();
            }
  }
        catch (JsonException ex)
        {
          Console.Error.WriteLine($"Failed to parse log chunk: {ex.Message}");
        }
    }

    [JSInvokable]
 public void LogError(string error)
    {
        logConnected = false;
 StateHasChanged();
  Task.Delay(2000).ContinueWith(async _ =>
        {
  if (!string.IsNullOrEmpty(selectedService))
    await ShowLogs(selectedService);
   });
    }

    [JSInvokable]
public void StatusError(string error)
    {
        statusConnected = false;
        StateHasChanged();
     Task.Delay(2000).ContinueWith(async _ => await ConnectStatus());
  }

    public async ValueTask DisposeAsync()
    {
        if (_interactive)
        {
         await JS.InvokeVoidAsync("logStream.serviceLog.close");
    await JS.InvokeVoidAsync("logStream.status.close");
        }

        logRef?.Dispose();
        statusRef?.Dispose();
    }
}
