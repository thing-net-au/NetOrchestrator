@rendermode InteractiveServer
@page "/"
@using System.Net.Http
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Orchestrator.Core
@using Orchestrator.Core.Models

@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Dashboard - Orchestrator</PageTitle>

<h1>Orchestrator Dashboard</h1>
<p class="lead">Real-time service orchestration and monitoring</p>

<div class="mb-3">
    <span><strong>Status stream:</strong> </span>
    @if (!statusConnected)
    {
        <span class="badge bg-danger">Disconnected</span>
        <button class="btn btn-sm btn-outline-primary ms-2" @onclick="ConnectStatus">
            <i class="bi bi-arrow-clockwise"></i> Reconnect
        </button>
    }
    else
    {
  <span class="badge bg-success">Live</span>
        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="DisconnectStatus">
            <i class="bi bi-x"></i> Disconnect
 </button>
    }
</div>

@if (services != null)
{
  <div class="row mb-4">
        <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
          <div class="card-body">
<h5 class="card-title"><i class="bi bi-collection"></i> Total Services</h5>
           <p class="display-4">@TotalServiceCount</p>
         </div>
            </div>
        </div>
        <div class="col-md-3">
 <div class="card text-white bg-success mb-3">
           <div class="card-body">
    <h5 class="card-title"><i class="bi bi-play-circle"></i> Running</h5>
        <p class="display-4">@RunningServiceCount</p>
 </div>
    </div>
   </div>
        <div class="col-md-3">
     <div class="card text-white bg-warning mb-3">
      <div class="card-body">
                 <h5 class="card-title"><i class="bi bi-stop-circle"></i> Stopped</h5>
               <p class="display-4">@(TotalServiceCount - RunningServiceCount)</p>
            </div>
            </div>
     </div>
        <div class="col-md-3">
      <div class="card text-white bg-info mb-3">
<div class="card-body">
         <h5 class="card-title"><i class="bi bi-layers"></i> Instances</h5>
        <p class="display-4">@TotalRunningInstances</p>
           </div>
            </div>
  </div>
    </div>
}

@if (services is null)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
</div>
      <p class="mt-2">Loading services...</p>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
 <h5 class="mb-0"><i class="bi bi-grid"></i> Services Overview</h5>
      </div>
              <div class="card-body p-0">
       <div class="table-responsive">
     <table class="table table-hover mb-0">
  <thead class="table-light">
           <tr>
            <th>Service</th>
 <th class="text-center">Instances</th>
 <th class="text-center">State</th>
   <th>Actions</th>
          </tr>
</thead>
   <tbody>
   @foreach (var svc in services.Take(5))
       {
           <tr>
        <td><strong>@svc.Name</strong></td>
    <td class="text-center">
        <span class="badge bg-@GetBadgeColor(svc.RunningInstances)">
               @svc.RunningInstances
          </span>
        </td>
             <td class="text-center">
    <span class="badge bg-@GetStateBadgeColor(svc.State)">
  @svc.State
 </span>
        </td>
          <td>
     <div class="btn-group btn-group-sm">
        <button class="btn btn-success" @onclick="() => Start(svc.Name)" title="Start">
          <i class="bi bi-play-fill"></i>
              </button>
        <button class="btn btn-danger" @onclick="() => Stop(svc.Name)" title="Stop">
             <i class="bi bi-stop-fill"></i>
    </button>
            <button class="btn btn-info" @onclick="() => ShowLogs(svc.Name)" title="Logs">
        <i class="bi bi-file-text"></i>
          </button>
         </div>
           </td>
     </tr>
          }
     @if (!services.Any())
       {
  <tr>
      <td colspan="4" class="text-center text-muted">No services configured</td>
           </tr>
       }
             </tbody>
         </table>
 </div>
    </div>
        @if (services.Count > 5)
       {
        <div class="card-footer text-center">
        <a href="/services" class="btn btn-sm btn-outline-primary">
       View All @services.Count Services
           </a>
        </div>
        }
          </div>
        </div>

        <div class="col-md-4">
            @if (processes != null && processes.Any())
   {
   <div class="card mb-4">
        <div class="card-header bg-dark text-white">
    <h5 class="mb-0"><i class="bi bi-cpu"></i> System Components</h5>
     </div>
           <div class="list-group list-group-flush">
 @foreach (var proc in processes)
          {
      <div class="list-group-item">
              <div class="d-flex w-100 justify-content-between align-items-center">
    <h6 class="mb-1">@proc.Name</h6>
        <span class="badge @(proc.IsHealthy ? "bg-success" : "bg-danger")">
             @(proc.IsHealthy ? "Healthy" : "Unhealthy")
  </span>
 </div>
     @if (!string.IsNullOrEmpty(proc.Details))
   {
    <p class="mb-1 small text-muted">@proc.Details</p>
                }
       </div>
    }
                 </div>
        <div class="card-footer text-center">
           <a href="/health" class="btn btn-sm btn-outline-primary">
                 View Health Details
     </a>
  </div>
     </div>
            }
      </div>
  </div>

    @if (selectedService != null && logConnected)
    {
        <div class="card mt-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-terminal"></i> <strong>@selectedService</strong> - Logs</span>
          <button class="btn btn-sm btn-outline-light" @onclick="DisconnectLog">
         <i class="bi bi-x"></i> Close
     </button>
         </div>
        <div class="card-body p-0">
     <pre class="bg-dark text-light p-3 mb-0" style="height:300px; overflow:auto; font-size:0.85rem; font-family: 'Consolas', monospace;">@foreach (var entry in logEntries.TakeLast(100))
{<div><span class="text-info">[@entry.Timestamp.ToString("HH:mm:ss.fff")]</span> <span class="text-light">@entry.Message</span></div>}</pre>
      </div>
        </div>
    }
}

<div class="mt-4">
<h5>Quick Actions</h5>
    <div class="d-flex gap-2">
      <a href="/services" class="btn btn-primary">
     <i class="bi bi-grid"></i> Manage Services
    </a>
        <a href="/health" class="btn btn-success">
          <i class="bi bi-heart-pulse"></i> System Health
        </a>
        <button class="btn btn-outline-secondary" @onclick="Refresh">
         <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>
</div>

@implements IAsyncDisposable

@code {
    private List<ServiceStatus>? services;
    private List<InternalStatus>? processes;
    private bool statusConnected;
    private bool logConnected;
    private string? selectedService;
    private List<(DateTime Timestamp, string Message)> logEntries = new();

  private int TotalServiceCount => services?.Count ?? 0;
    private int RunningServiceCount => services?.Count(s => s.State == State.Running) ?? 0;
    private int TotalRunningInstances => services?.Sum(s => s.RunningInstances) ?? 0;

    private DotNetObjectReference<Index>? statusRef;
    private DotNetObjectReference<Index>? logRef;

    private bool _interactive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
   {
            _interactive = true;
   await ConnectStatus();
   }
    }

    protected override async Task OnInitializedAsync()
{
        await Refresh();
    }

    private string GetBadgeColor(int count) => count switch
    {
        0 => "secondary",
    1 => "primary",
        _ => "success"
    };

  private string GetStateBadgeColor(State state) => state switch
    {
    State.Running => "success",
        State.Stopped => "warning",
        State.Failed => "danger",
        State.Suspended => "info",
        _ => "secondary"
    };

    private async Task ConnectStatus()
  {
        var baseUri = new Uri(Nav.BaseUri);
        var apiPort = OrchestratorConfig.Current.Web.ApiPort;
        var apiOrigin = new UriBuilder(baseUri.Scheme, baseUri.Host, apiPort).Uri;

        statusRef?.Dispose();
        statusRef = DotNetObjectReference.Create(this);

        var statusUrl = new Uri(apiOrigin, "/api/services/stream").ToString();

        await JS.InvokeVoidAsync("logStream.status.open", statusRef, statusUrl);
        statusConnected = true;
        StateHasChanged();
    }

    private async Task DisconnectStatus()
    {
        await JS.InvokeVoidAsync("logStream.status.close");
        statusConnected = false;
    StateHasChanged();
    }

    private async Task Refresh()
    {
      try
      {
        var client = ClientFactory.CreateClient("OrcApi");
            services = await client.GetFromJsonAsync<List<ServiceStatus>>("api/services");
       processes = await client.GetFromJsonAsync<List<InternalStatus>>("api/services/internal");
      StateHasChanged();
        }
     catch (Exception ex)
        {
  Console.Error.WriteLine($"Failed to refresh: {ex.Message}");
        }
    }

    private async Task Start(string name)
    {
        try
        {
    var client = ClientFactory.CreateClient("OrcApi");
            await client.PostAsync($"api/services/{name}/start", null);
   await Task.Delay(500);
            await Refresh();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to start service: {ex.Message}");
   }
    }

    private async Task Stop(string name)
    {
        try
        {
         var client = ClientFactory.CreateClient("OrcApi");
       await client.PostAsync($"api/services/{name}/stop", null);
await Task.Delay(500);
            await Refresh();
 }
 catch (Exception ex)
        {
      Console.Error.WriteLine($"Failed to stop service: {ex.Message}");
        }
    }

  private async Task ShowLogs(string name)
    {
        selectedService = name;
        var baseUri = new Uri(Nav.BaseUri);
        var apiPort = OrchestratorConfig.Current.Web.ApiPort;
      var apiOrigin = new UriBuilder(baseUri.Scheme, baseUri.Host, apiPort).Uri;

        var logsUrl = new Uri(apiOrigin, $"/api/services/{name}/logs/stream").ToString();
        logEntries.Clear();
        logConnected = false;

        logRef?.Dispose();
        logRef = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync("logStream.serviceLog.open", logRef, logsUrl);
 logConnected = true;
        StateHasChanged();
    }

    private async Task DisconnectLog()
    {
        await JS.InvokeVoidAsync("logStream.serviceLog.close");
        logConnected = false;
        selectedService = null;
   StateHasChanged();
    }

    [JSInvokable]
    public void StatusOpened()
    {
    statusConnected = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void ReceiveStatus(string json)
    {
        try
        {
       var updated = JsonSerializer.Deserialize<ServiceStatus>(json);
 if (updated != null && services != null)
            {
         var svc = services.FirstOrDefault(s => s.Name == updated.Name);
         if (svc != null)
    {
          svc.RunningInstances = updated.RunningInstances;
        svc.State = updated.State;
          StateHasChanged();
                }
            }
        }
      catch (Exception ex)
        {
   Console.Error.WriteLine($"Failed to parse status: {ex.Message}");
   }
    }

    [JSInvokable]
    public void ReceiveLogChunk(string chunk)
    {
   try
        {
            const int MaxLogEntries = 500;
            var message = JsonSerializer.Deserialize<ConsoleLogMessage>(chunk);
      if (message != null)
        {
                if (logEntries.Count >= MaxLogEntries)
         logEntries.RemoveAt(0);
         logEntries.Add((message.Timestamp, message.Details ?? ""));
                logConnected = true;
            StateHasChanged();
      }
    }
        catch (JsonException ex)
        {
      Console.Error.WriteLine($"Failed to parse log chunk: {ex.Message}");
   }
    }

  [JSInvokable]
    public void LogError(string error)
    {
        logConnected = false;
        StateHasChanged();
      Task.Delay(2000).ContinueWith(async _ =>
        {
 if (!string.IsNullOrEmpty(selectedService))
await ShowLogs(selectedService);
        });
    }

  [JSInvokable]
    public void StatusError(string error)
  {
        statusConnected = false;
        StateHasChanged();
        Task.Delay(2000).ContinueWith(async _ => await ConnectStatus());
    }

public async ValueTask DisposeAsync()
    {
        if (_interactive)
      {
      await JS.InvokeVoidAsync("logStream.serviceLog.close");
   await JS.InvokeVoidAsync("logStream.status.close");
        }

        logRef?.Dispose();
statusRef?.Dispose();
    }
}

